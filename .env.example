# Copie para .env e preencha. O .env real nunca vai para o git.

# --- Supabase ----------------------------------------------------------------
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# IGNORA RLS. Apenas no pipeline local, nunca no frontend.
SUPABASE_SECRET_KEY=

# --- Conexao Postgres direta (obrigatoria para os pipelines) -----------------
# Supabase Dashboard > Project Settings > Database > Connection string > URI
DATABASE_URL=

# --- Fontes externas ---------------------------------------------------------
# Opcional: sem token a validacao cruzada de precos e pulada com aviso.
BRAPI_TOKEN=

# --- Runtime -----------------------------------------------------------------
DATA_DIR=./data
LOG_LEVEL=INFO
